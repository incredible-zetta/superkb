# ── Hindsight RAG indexer — single-image build for EasyPanel ─────────────────
# Mirrors the `hindsight` service in docker-compose.yml but packaged as a
# standalone Dockerfile so EasyPanel can deploy it as one service (no
# docker-compose dependency).
#
# Build context must include this Dockerfile only — no source code required.
# All config comes from environment variables (see .env.hindsight.example).
#
# EasyPanel setup:
#   1. Create new service → Type: App → Source: Dockerfile.
#   2. Dockerfile path: Dockerfile.hindsight
#   3. Port: 8888 (API) and 9999 (Control plane UI). Map only what you expose.
#   4. Mount two **Docker named volumes** (NEVER host bind mounts). Both
#      auto-owned by UID 1000 → no #1483 crash, no chown gymnastics:
#        /home/hindsight/.pg0              → `hindsight-data`   (REQUIRED)
#            Banks, embeddings, facts, mental models. Lose this = blank.
#        /home/hindsight/.cache/huggingface → `hindsight-hf-cache` (OPTIONAL)
#            Model cache (~73MB). Without it every restart re-downloads
#            BAAI/bge-small-en-v1.5 + ms-marco-TinyBERT-L-2-v2 and adds
#            ~5-10s to cold start. No data loss either way.
#   5. Set env vars from .env.hindsight.example.
#   6. Healthcheck: HTTP GET /health on port 8888.
#
# Volumes:
#   /home/hindsight/.pg0              — REQUIRED. Postgres-style bank data.
#   /home/hindsight/.cache/huggingface — OPTIONAL. HuggingFace model cache.

# ── build stage: tiny customizations on top of upstream image ────────────────
FROM ghcr.io/vectorize-io/hindsight:latest AS upstream

# ── runtime stage: same upstream, plus healthcheck and a clear entrypoint ────
FROM upstream

# Hindsight runs rootless as UID:GID 1000:1000 and ships an embedded
# PostgreSQL (pg0) that runs `initdb` on startup. initdb refuses to run as
# root, and pg0 also refuses to start if its data dir is not owned by
# UID 1000 (Hindsight issue #1483). Two things must hold at runtime:
#
#   1. The container must run as UID 1000. We force it explicitly because
#      some orchestrators (EasyPanel included) ignore the upstream
#      USER directive.
#   2. /home/hindsight/.pg0 must be writable by UID 1000. With a Docker
#      named volume this is automatic. With a host bind mount the host
#      directory's owner must be UID 1000 (or 1000:1000), otherwise pg0
#      aborts with: "embedded database directory is not writable by this
#      container (UID 1000)".
#
# We do all privileged work in a single RUN as root, then drop to UID 1000
# permanently. Any chown we do is a no-op for bind mounts (host owner wins);
# the real fix is on the deploy side (named volume, or chown host dir).
ARG HINDSIGHT_UID=1000
ARG HINDSIGHT_GID=1000
USER root
RUN set -eux; \
    if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache curl ca-certificates; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates && rm -rf /var/lib/apt/lists/*; \
    fi; \
    mkdir -p /home/hindsight/.pg0; \
    # Ensure the runtime user exists with the expected UID. Upstream ships
    # a `hindsight` user at UID 1000 already, but be defensive: if absent,
    # create it. If a bind mount overrides the dir's owner, that's a
    # deploy-side issue (see #1483) — surface it loudly via a startup
    # writability check below.
    if ! getent passwd "${HINDSIGHT_UID}" >/dev/null; then \
      if command -v adduser >/dev/null 2>&1; then \
        adduser -D -u "${HINDSIGHT_UID}" -g "${HINDSIGHT_GID}" hindsight; \
      elif command -v useradd >/dev/null 2>&1; then \
        useradd -u "${HINDSIGHT_UID}" -g "${HINDSIGHT_GID}" -m -d /home/hindsight hindsight; \
      fi; \
    fi; \
    # Best-effort chown for named-volume case; harmless on bind mount.
    chown -R "${HINDSIGHT_UID}:${HINDSIGHT_GID}" /home/hindsight || true

# Force the runtime user explicitly. Numeric UID is safer than a name
# because the upstream entrypoint may shell out without resolving names.
USER ${HINDSIGHT_UID}:${HINDSIGHT_GID}

# EasyPanel will exec the upstream image's default entrypoint; we just add
# metadata + healthcheck.
EXPOSE 8888 9999

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=10 \
  CMD curl -fsS http://localhost:8888/health || exit 1

# Inherit the upstream image's ENTRYPOINT/CMD by not setting our own.
# EasyPanel can override CMD at runtime if needed.
