# ── Hindsight standalone service env (EasyPanel) ────────────────────────────
# Copy values into the EasyPanel service "Environment" tab. Anything you omit
# falls back to the upstream image default.
#
# ── Volume requirement (read this first) ────────────────────────────────
# Hindsight runs rootless as UID:GID 1000:1000 and refuses to start if
# /home/hindsight/.pg0 is not owned by 1000:1000. With a Docker NAMED volume
# this is automatic. With a HOST BIND MOUNT you must chown the host dir to
# 1000:1000 before mount, or Hindsight crashes with:
#   "embedded database directory /home/hindsight/.pg0 is not writable
#    by this container (UID 1000)"
# See https://github.com/vectorize-io/hindsight/issues/1483
#
# ── Required volume ─────────────────────────────────────────────────────
#   /home/hindsight/.pg0             → named volume `hindsight-data`
#   (banks, embeddings, facts, mental models — lose this = blank Hindsight)
#
# ── Optional volume (perf) ─────────────────────────────────────────────
#   /home/hindsight/.cache/huggingface → named volume `hindsight-hf-cache`
#   (caches BAAI/bge-small-en-v1.5 + ms-marco-TinyBERT-L-2-v2; without it
#    every restart re-downloads ~73MB and adds ~5-10s to cold start)

# Hindsight → LLM provider (fact extraction)
# none    = no LLM, no key (vector + keyword + graph recall only)
# openai  = OpenAI-compatible gateway (e.g. 9router)
# gemini  = Google Gemini
# groq    = Groq
# anthropic = Anthropic
HINDSIGHT_API_LLM_PROVIDER=openai

# Only required when LLM_PROVIDER != none
HINDSIGHT_API_LLM_BASE_URL=https://api.openai.com/v1
HINDSIGHT_API_LLM_API_KEY=replace_me
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini

# Hindsight → embeddings provider
# local = in-process 384-dim model (no key, default for fast path)
# openai / google = remote (changing provider changes vector space → rebuild
# all banks)
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1536
HINDSIGHT_API_EMBEDDINGS_GEMINI_API_KEY=
HINDSIGHT_API_EMBEDDINGS_GEMINI_MODEL=gemini-embedding-001

# Hindsight → reranker (recall latency knob; no bank rebuild needed)
HINDSIGHT_API_RERANKER_PROVIDER=flashrank
HINDSIGHT_API_RERANKER_FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=50

# Hindsight's bundled DB password (upstream default)
HINDSIGHT_DB_PASSWORD=hindsight

# Profile label (logical namespace inside the same Hindsight instance)
HINDSIGHT_PROFILE=default

# ── For superkb engine clients (set on the consumer, NOT on this service) ───
# HINDSIGHT_BASE_URL=http://hindsight.<your-easypanel-domain>:8888
# HINDSIGHT_API_KEY=
