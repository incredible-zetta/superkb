# ── superkb engine ──────────────────────────────────────────────────────────
# HTTP
HTTP_PORT=8080
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=15

# Postgres (metadata only — no vectors)
# Host value for running the binary locally. In docker compose this is
# overridden to the "postgres" service host.
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/superkb?sslmode=disable

# ── Object storage: Cloudflare R2 (S3-compatible) ────────────────────────────
# Create an R2 bucket + API token (Access Key ID / Secret) in the Cloudflare
# dashboard. Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=superkb
S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
S3_USE_PATH_STYLE=true

# ── Hindsight RAG indexer (superkb engine → Hindsight) ───────────────────────
# Host value for local runs; compose overrides to http://hindsight:8888.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_PROFILE=default
HINDSIGHT_TIMEOUT_SEC=120

# Basic auth for service-to-service access (required when AUTH_ENABLED=true)
AUTH_ENABLED=true
AUTH_USERNAME=superkb
AUTH_PASSWORD=change-me

# Background build worker
WORKER_CONCURRENCY=2
WORKER_QUEUE_SIZE=64

# ── Hindsight container: LLM for fact extraction (Hindsight → LLM provider) ──
# MiniMax is supported. Get an API key from https://www.minimax.io/.
# Alternatives needing NO key: set HINDSIGHT_API_LLM_PROVIDER=llamacpp (local,
# auto-downloads a model) or =none (chunk storage + vector search only, no
# fact extraction). Embeddings default to a local model (no key required).
HINDSIGHT_API_LLM_PROVIDER=minimax
HINDSIGHT_API_LLM_API_KEY=<MINIMAX_API_KEY>
HINDSIGHT_API_LLM_MODEL=MiniMax-Text-01

# Hindsight's own Postgres password (used by the bundled compose DB).
HINDSIGHT_DB_PASSWORD=hindsight
