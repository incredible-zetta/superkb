# ── superkb engine ──────────────────────────────────────────────────────────
# HTTP
HTTP_PORT=8080
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=15

# Postgres (metadata only — no vectors)
# Host value for running the binary locally. In docker compose this is
# overridden to the "postgres" service host.
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/superkb?sslmode=disable

# ── Object storage: Cloudflare R2 (S3-compatible) ────────────────────────────
# Create an R2 bucket + API token (Access Key ID / Secret) in the Cloudflare
# dashboard. Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=superkb
S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
S3_USE_PATH_STYLE=true

# ── Hindsight RAG indexer (superkb engine → Hindsight) ───────────────────────
# Host value for local runs; compose overrides to http://hindsight:8888.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_PROFILE=default
HINDSIGHT_TIMEOUT_SEC=120

# Basic auth for service-to-service access (required when AUTH_ENABLED=true)
AUTH_ENABLED=true
AUTH_USERNAME=superkb
AUTH_PASSWORD=change-me

# Background build worker
WORKER_CONCURRENCY=2
WORKER_QUEUE_SIZE=64

# ── Hindsight container: LLM for fact extraction (Hindsight → LLM provider) ──
# IMPORTANT: MiniMax-Text-01 is NOT compatible with Hindsight fact extraction.
# It rejects Hindsight's structured-output schema (response_format json_object
# unsupported; strict json_schema rejects the facts[] schema). Verified failing.
#
# Recommended providers:
#   none     - chunk storage + vector/keyword/graph search, NO LLM, NO key.
#              Fully working for knowledge-base search; loses fact extraction
#              and reflect. Best zero-cost default.
#   llamacpp - local LLM, no key, auto-downloads a model (needs RAM).
#   openai / gemini / groq / anthropic - full fact extraction, needs that
#              provider's key (Groq has a free tier).
HINDSIGHT_API_LLM_PROVIDER=none

# Only used when a real LLM provider is set (ignored for provider=none):
# HINDSIGHT_API_LLM_API_KEY=<PROVIDER_API_KEY>
# HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
# Some hosted models cap max_tokens; pass provider-native overrides here:
# HINDSIGHT_API_LLM_EXTRA_BODY={"max_tokens":32000}
# Force strict json_schema instead of json_object for weak structured-output models:
# HINDSIGHT_API_LLM_STRICT_SCHEMA=true

# Hindsight's own Postgres password (used by the bundled compose DB).
HINDSIGHT_DB_PASSWORD=hindsight

# ── Hindsight embeddings (Hindsight → embedding provider) ─────────────────
# Default `local` uses an in-process model (BAAI/bge-small-en-v1.5, 384 dims,
# no key). To use an OpenAI-compatible gateway (e.g. 9router) set provider to
# `openai` and point the base URL at it. From inside the container the host is
# reachable as host.docker.internal (mapped in docker-compose).
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://host.docker.internal:20128/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=<NINEROUTER_KEY>
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=openai/text-embedding-3-small
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1536
